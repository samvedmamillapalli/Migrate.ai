# Application
APP_NAME=Migration Oracle
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000

# CockroachDB
# Paste the CockroachDB Cloud "General connection string" as-is (postgresql://...).
# The app normalizes it to cockroachdb+psycopg:// and attaches the CA cert when needed.
# Local insecure:
# DATABASE_URL=postgresql://root@localhost:26257/migration_oracle?sslmode=disable
# CockroachDB Cloud (sslmode=verify-full; CA auto-detected from:
#   Windows: %APPDATA%\postgresql\root.crt
#   macOS/Linux: ~/.postgresql/root.crt
DATABASE_URL=postgresql://USER:PASSWORD@HOST:26257/migration_oracle?sslmode=verify-full

# Customer schema discovery timeouts (seconds)
SCHEMA_CONNECTION_TIMEOUT_SECONDS=30
SCHEMA_DISCOVERY_TIMEOUT_SECONDS=60

# AWS SDK authentication
# Prefer AWS_PROFILE locally and an IAM execution role in deployed environments.
# Only use the access-key variables when profile/role authentication is unavailable.
AWS_DEFAULT_REGION=us-east-1
AWS_PROFILE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Planned AWS resources (not used by the backend foundation yet)
BEDROCK_PREDICTION_MODEL_ID=
BEDROCK_EMBEDDING_MODEL_ID=
MIGRATION_WORKFLOW_ARN=
RUN_ARTIFACTS_BUCKET=
USER_DATABASE_SECRET_PREFIX=migration-oracle/connections
CCLOUD_API_KEY_SECRET_ARN=

# CockroachDB Cloud automation (local development only; use Secrets Manager on AWS)
CCLOUD_API_KEY=
