# =============================================================================
# TEAMMATE MINIMUM — copy a filled .env from the team (do not commit secrets).
# With these set, you do NOT need to run sam deploy. Shared stack is already up.
# =============================================================================
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:26257/migration_oracle?sslmode=verify-full
# AWS_ENABLED=true
# AWS_DEFAULT_REGION=us-east-1
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# MIGRATION_WORKFLOW_ARN=arn:aws:states:us-east-1:...:stateMachine:migration-oracle-migration-workflow
# RUN_ARTIFACTS_BUCKET=migration-oracle-artifacts-...
# BEDROCK_PREDICTION_MODEL_ID=us.anthropic.claude-sonnet-4-6
# BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
# SHADOW_PROVIDER=ccloud_api
# CCLOUD_API_SECRET=...
#
# Machine prerequisites: Git + Python 3.12+. No Docker / SAM / Node for normal use.
# Cockroach CA ships in certs/cockroach-cloud-ca.crt (setup installs it for you).
#
# Then from repo root (two commands):
#   python scripts/dev.py setup
#   python scripts/dev.py restart
# Open http://127.0.0.1:8000/ui  (health strip should say SFN ready)
# =============================================================================

# Application
APP_NAME=Migration Oracle
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# CORS (comma-separated exact origins — no wildcards).
# Local same-origin /ui needs no CORS. Add a separate frontend origin when used:
#   CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-frontend.example
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# CockroachDB
# Paste the CockroachDB Cloud "General connection string" as-is (postgresql://...).
# The app normalizes it to cockroachdb+psycopg:// and attaches the CA cert when needed.
# Local insecure:
# DATABASE_URL=postgresql://root@localhost:26257/migration_oracle?sslmode=disable
# CockroachDB Cloud (sslmode=verify-full; CA auto-detected from:
#   Windows: %APPDATA%\postgresql\root.crt
#   macOS/Linux: ~/.postgresql\root.crt
DATABASE_URL=postgresql://USER:PASSWORD@HOST:26257/migration_oracle?sslmode=verify-full

# Customer schema discovery timeouts (seconds)
SCHEMA_CONNECTION_TIMEOUT_SECONDS=30
SCHEMA_DISCOVERY_TIMEOUT_SECONDS=60

# --- Phase 8A: AWS infrastructure foundation ---
# Master switch. Set false for local work that does not touch AWS at all.
AWS_ENABLED=true

# Region and authentication.
# Prefer AWS_PROFILE locally and an IAM execution role in deployed environments.
# Only use the access-key variables when profile/role authentication is unavailable.
# Never commit real credentials. Never log these values.
AWS_DEFAULT_REGION=us-east-1
AWS_PROFILE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Client timeouts / retries
AWS_CONNECT_TIMEOUT_SECONDS=5
AWS_READ_TIMEOUT_SECONDS=10
AWS_MAX_ATTEMPTS=3

# Step Functions + S3 — shared stack `migration-oracle` (already deployed for the team).
# Copy from a teammate .env. Do NOT redeploy unless Lambda/ASL code changed.
# Required when ENVIRONMENT is demo/staging/production OR AWS_REQUIRE_WORKFLOW_CONFIG=true
MIGRATION_WORKFLOW_ARN=
RUN_ARTIFACTS_BUCKET=
AWS_REQUIRE_WORKFLOW_CONFIG=false
AWS_STEP_FUNCTIONS_ENDPOINT_URL=

# Lambda naming / ARNs (optional; ASL uses DefinitionSubstitutions at deploy)
AWS_LAMBDA_FUNCTION_PREFIX=migration-oracle
AWS_LAMBDA_ENDPOINT_URL=
AWS_ACCOUNT_ID=
AWS_LAMBDA_DISCOVER_SCHEMA_ARN=
AWS_LAMBDA_PROVISION_SHADOW_CLUSTER_ARN=
AWS_LAMBDA_LOAD_SCHEMA_ARN=
AWS_LAMBDA_EXECUTE_MIGRATION_ARN=
AWS_LAMBDA_COLLECT_METRICS_ARN=
AWS_LAMBDA_PERSIST_RESULTS_ARN=
AWS_LAMBDA_CLEANUP_ARN=

# S3 endpoint override (localstack only)
AWS_S3_ENDPOINT_URL=

# Secrets Manager
USER_DATABASE_SECRET_PREFIX=migration-oracle/connections
CCLOUD_API_KEY_SECRET_ARN=
AWS_SECRETS_MANAGER_ENDPOINT_URL=
AWS_SECRETS_CACHE_TTL_SECONDS=300

# CloudWatch (log groups are created automatically; primary group optional override)
AWS_CLOUDWATCH_NAMESPACE=MigrationOracle
AWS_CLOUDWATCH_LOG_GROUP=/migration-oracle/application
AWS_CLOUDWATCH_ENDPOINT_URL=
AWS_CLOUDWATCH_LOG_RETENTION_DAYS=14

# CloudWatch alarms (cleanup failure / orphaned shadow clusters)
AWS_ALARM_CLEANUP_FAILED_THRESHOLD=1
AWS_ALARM_CLEANUP_FAILED_PERIOD_SECONDS=60
AWS_ALARM_CLEANUP_FAILED_EVALUATION_PERIODS=5
AWS_ALARM_ORPHANED_CLUSTERS_THRESHOLD=1
AWS_ALARM_ORPHANED_CLUSTERS_PERIOD_SECONDS=300
AWS_ALARM_ORPHANED_CLUSTERS_EVALUATION_PERIODS=2

# Demo deploy gate — when set, mutating/API routes require header X-API-Key.
# Leave empty for open local development. Health and /ui stay public.
DEMO_API_KEY=

# Optional CockroachDB Managed MCP endpoint (docs / attribution; IDE uses .cursor/mcp.json)
COCKROACH_MCP_URL=https://cockroachlabs.cloud/mcp

# --- Phase 9: Amazon Bedrock (AI prediction + recommendation) ---
# Prerequisite: request Anthropic Claude model access in the Bedrock console
# for region us-east-1 (or BEDROCK_REGION) before live calls will succeed.
# Leave blank until access is granted; the app fails with an actionable error
# rather than an opaque AWS exception.
BEDROCK_PREDICTION_MODEL_ID=us.anthropic.claude-sonnet-4-6
# Optional; defaults to BEDROCK_PREDICTION_MODEL_ID when unset.
BEDROCK_RECOMMENDATION_MODEL_ID=us.anthropic.claude-sonnet-4-6
# Defaults to AWS_DEFAULT_REGION when unset in code; set explicitly if needed.
BEDROCK_REGION=us-east-1
# Phase 10 embeddings — Amazon Titan (1024-d). REQUIRED for live memory write.
# Do not hardcode in application code; set here / in Lambda env.
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# --- Phase 7: Shadow cluster orchestration ---
# Provider backend:
#   "ccloud_api" - real CockroachDB Cloud provisioning via the REST API (default;
#                  verified in Phase 7A-7C).
#   "mock"       - offline scratch DB on the control-plane cluster. Optional,
#                  offline-demo only; not used by default.
#   "ccloud"     - ccloud CLI (interactive browser auth only; NOT headless).
SHADOW_PROVIDER=ccloud_api
# Name/tag prefix on every shadow cluster so the sweeper can find orphans.
SHADOW_APP_TAG=migration-oracle
# Single-region provisioning, colocated with the AWS services used elsewhere.
SHADOW_CLUSTER_CLOUD=aws
SHADOW_CLUSTER_REGION=us-east-1
# Concurrency cap: at most this many simultaneous shadow clusters; overflow waits.
SHADOW_MAX_CONCURRENT=2
# Max cluster lifetime (minutes); the sweeper reaps active clusters older than this.
SHADOW_MAX_LIFETIME_MINUTES=30
# How long a caller waits for a free concurrency slot before giving up (seconds).
SHADOW_SLOT_WAIT_TIMEOUT_SECONDS=600
SHADOW_SLOT_POLL_INTERVAL_SECONDS=2.0
# Provisioning latency is measured, not assumed; these are safety ceilings.
SHADOW_PROVISION_TIMEOUT_SECONDS=600
SHADOW_READY_POLL_INTERVAL_SECONDS=5.0
SHADOW_SEED_TIMEOUT_SECONDS=300
SHADOW_MIGRATE_TIMEOUT_SECONDS=600

# CockroachDB Cloud automation (local development + Lambda env via sam deploy).
# CCLOUD_API_SECRET must be the FULL secret shown once when creating the API key
# (format CCDB1_<part>_<part>). That string is the Bearer token.
# CCLOUD_API_KEY is optional metadata; if SECRET looks truncated, the app may
# fall back to KEY when KEY looks like a full CCDB1_x_y secret.
CCLOUD_BINARY=ccloud
CCLOUD_API_KEY=
CCLOUD_API_SECRET=
CCLOUD_API_BASE_URL=https://cockroachlabs.cloud
SHADOW_CLUSTER_PLAN=BASIC
CCLOUD_API_TIMEOUT_SECONDS=30
CCLOUD_API_MAX_RETRIES=4
CCLOUD_API_BACKOFF_BASE_SECONDS=0.5
