# Clerk Authentication (Optional — uncomment to enable Clerk JWT verification)
# CLERK_SECRET_KEY=sk_test_XXXXXXXXXXXXXXXXXXXXXXXXX
# CLERK_PUBLISHABLE_KEY=pk_test_XXXXXXXXXXXXXXXXXXXXXXXXX
# CLERK_FRONTEND_API_URL=https://clerk.abc123.accounts.dev

# Database
DATABASE_URL=postgresql://root@localhost:26257/migration_oracle?sslmode=disable

# AWS Configuration
AWS_ENABLED=false
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Bedrock (AI prediction)
BEDROCK_PREDICTION_MODEL_ID=

# Demo API Key (optional gate)
DEMO_API_KEY=

# Auth (legacy custom auth — Clerk takes precedence when configured)
AUTH_ENABLED=false
AUTH_SECRET=
AUTH_TOKEN_TTL_SECONDS=604800

# Shadow cluster (CockroachDB Cloud)
CLOUD_API_KEY=
CLOUD_API_SECRET=
SHADOW_PROVIDER=mock

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# App
APP_NAME=Migration Oracle
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Slack (optional — lifecycle notifications). See docs/SLACK_INTEGRATION.md,
# especially the "Going public" checklist before deploying off localhost.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
# Must match the redirect URL registered in the Slack app's OAuth config,
# exactly — Slack rejects on any mismatch. Points at the BACKEND, not the
# frontend (this app's own callback route lives on the FastAPI server).
SLACK_REDIRECT_URI=http://localhost:8003/api/slack/oauth/callback
# Signs/verifies the OAuth `state` param (HMAC-SHA256). Required — a blank
# value makes /api/slack/install fail outright.
SLACK_STATE_SECRET=
# Fernet key encrypting the bot token at rest (generate with
# `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`).
# In production this is required — SlackOAuthService hard-refuses to fall
# back to a derived key when ENVIRONMENT=production.
SLACK_TOKEN_ENCRYPTION_KEY=
# Absolute FRONTEND URLs — a relative path here resolves against the
# backend's own origin after the OAuth redirect, not the frontend's, and
# 404s.
SLACK_INSTALL_SUCCESS_REDIRECT=http://localhost:3000/dashboard/settings?slack=connected
SLACK_INSTALL_ERROR_REDIRECT=http://localhost:3000/dashboard/settings?slack=error
# Drives the "Open in Migration Oracle" deep link inside Slack notifications.
FRONTEND_URL=http://localhost:3000
# Last-resort fallback channel — only used for installations that predate
# the authed_user_id column. Normal delivery DMs the OAuth installer.
SLACK_DEFAULT_CHANNEL=general
