# Clerk Authentication (Optional — uncomment to enable Clerk JWT verification)
# CLERK_SECRET_KEY=sk_test_XXXXXXXXXXXXXXXXXXXXXXXXX
# CLERK_PUBLISHABLE_KEY=pk_test_XXXXXXXXXXXXXXXXXXXXXXXXX
# CLERK_FRONTEND_API_URL=https://clerk.abc123.accounts.dev

# Database
DATABASE_URL=postgresql://root@localhost:26257/migration_oracle?sslmode=disable

# AWS Configuration
AWS_ENABLED=false
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Bedrock (AI prediction)
BEDROCK_PREDICTION_MODEL_ID=

# Demo API Key (optional gate)
DEMO_API_KEY=

# Auth (legacy custom auth — Clerk takes precedence when configured)
AUTH_ENABLED=false
AUTH_SECRET=
AUTH_TOKEN_TTL_SECONDS=604800

# Shadow cluster (CockroachDB Cloud)
CLOUD_API_KEY=
CLOUD_API_SECRET=
SHADOW_PROVIDER=mock

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# App
APP_NAME=Migration Oracle
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Slack (optional — lifecycle notifications). See docs/SLACK_INTEGRATION.md,
# especially the "Going public" checklist before deploying off localhost.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
# Must match the redirect URL registered in the Slack app's OAuth config,
# exactly — Slack rejects on any mismatch. Points at the BACKEND, not the
# frontend (this app's own callback route lives on the FastAPI server).
SLACK_REDIRECT_URI=http://localhost:8003/api/slack/oauth/callback
# Signs/verifies the OAuth `state` param (HMAC-SHA256). Required — a blank
# value makes /api/slack/install fail outright.
SLACK_STATE_SECRET=
# Fernet key encrypting the bot token at rest (generate with
# `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`).
# In production this is required — SlackOAuthService hard-refuses to fall
# back to a derived key when ENVIRONMENT=production.
SLACK_TOKEN_ENCRYPTION_KEY=
# Absolute FRONTEND URLs — a relative path here resolves against the
# backend's own origin after the OAuth redirect, not the frontend's, and
# 404s.
SLACK_INSTALL_SUCCESS_REDIRECT=http://localhost:3000/dashboard/settings?slack=connected
SLACK_INSTALL_ERROR_REDIRECT=http://localhost:3000/dashboard/settings?slack=error
# Drives the "Open in Migration Oracle" deep link inside Slack notifications.
FRONTEND_URL=http://localhost:3000
# Last-resort fallback channel — only used for installations that predate
# the authed_user_id column. Normal delivery DMs the OAuth installer.
SLACK_DEFAULT_CHANNEL=general

# GitHub App (optional — PR integration). See docs/GITHUB_APP_SETUP.md for
# the full manual registration walkthrough.
GITHUB_APP_ID=
# Full PEM contents, header/footer included. Most hosts accept a pasted
# multi-line value directly; some need literal \n line breaks.
GITHUB_APP_PRIVATE_KEY=
# Must match the webhook secret configured on the App's webhook settings
# page, exactly — every inbound webhook is HMAC-verified against this.
GITHUB_WEBHOOK_SECRET=
GITHUB_API_BASE_URL=https://api.github.com

# GitHub OAuth identity (optional — "who is this GitHub identity", for
# workspace-invite matching; a DIFFERENT credential from the App above,
# never used to act on any repo). Every GitHub App also has its own Client
# ID/Client Secret pair for a standard OAuth flow — reuse the same App's
# credentials here (visible on the same App settings page as the private
# key) rather than registering a second one.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Points at the BACKEND's callback route, not the frontend. Must match the
# callback URL registered on the App's OAuth settings, exactly.
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8003/api/github/oauth/callback
# Signs/verifies the OAuth `state` param (HMAC-SHA256). Required — a blank
# value makes /api/github/install fail outright.
GITHUB_OAUTH_STATE_SECRET=
# Fernet key encrypting the access token at rest (same convention as
# SLACK_TOKEN_ENCRYPTION_KEY — generate with
# `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`).
# Unset falls back to a dev-only derived key outside production.
GITHUB_OAUTH_TOKEN_ENCRYPTION_KEY=
GITHUB_OAUTH_INSTALL_SUCCESS_REDIRECT=http://localhost:3000/dashboard/settings?github=connected
GITHUB_OAUTH_INSTALL_ERROR_REDIRECT=http://localhost:3000/dashboard/settings?github=error

# SES (optional — workspace invite emails). Must be a verified SES sender
# identity; SES sandbox mode also requires the recipient to be verified
# until the account is out of sandbox. Unset means invite emails are
# skipped (logged, not fatal) — the invite record/link still works.
SES_SENDER_EMAIL=
